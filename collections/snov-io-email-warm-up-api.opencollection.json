{
  "opencollection": "1.0.0",
  "info": {
    "name": "Snov.io Authentication Email Warm-up API",
    "version": "2.0"
  },
  "items": [
    {
      "info": {
        "name": "Email Warm-up",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List warm-up campaigns",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.snov.io/v2/warm-up",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a paginated list of all email warm-up campaigns."
        },
        {
          "info": {
            "name": "Create warm-up campaign",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.snov.io/v2/warm-up",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new email warm-up campaign to improve deliverability scores."
        },
        {
          "info": {
            "name": "Get warm-up campaign",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.snov.io/v2/warm-up/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Campaign ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve full details of a specific warm-up campaign."
        },
        {
          "info": {
            "name": "Update warm-up campaign",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.snov.io/v2/warm-up/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Campaign ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update settings of an existing warm-up campaign."
        }
      ]
    }
  ],
  "bundled": true
}